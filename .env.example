# PostgreSQL. Neon/Render URLs starting with postgres:// or postgresql:// are accepted (psycopg v3 is used).
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/bonayon
# Long random string: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Comma-separated allowlist of frontend origins
CORS_ORIGINS=http://localhost:5173
# nasa = live NASA POWER (needs internet), mock = deterministic SYNTHETIC data for development
CLIMATE_PROVIDER=mock
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point
# Tests (never point this at real data: tables are dropped and recreated)
# TEST_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/bonayon_test
